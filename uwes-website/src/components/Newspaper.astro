---
import { getCollection } from 'astro:content';
import { formatDate } from '../data/terms.ts';

const issues = (await getCollection('newsletter'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<div class="newspaper card">
  <div class="section-header">
    <h2>Weekly Newsletter</h2>
    <a href="/newspaper" class="view-all">View All →</a>
  </div>

  <ul class="issue-list">
    {issues.map((issue) => (
      <li class="issue-item">
        <p class="issue-date">{formatDate(issue.data.date)}</p>
        <h3 class="issue-title"><a href={`/newspaper/${issue.id}`}>{issue.data.title}</a></h3>
        <p class="issue-author">{issue.data.author}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .section-header {
    margin-bottom: 1.5rem;
  }

  .issue-list {
    list-style: none;
  }

  .issue-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .issue-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .issue-title {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .issue-title a {
    color: inherit;
  }

  .issue-title a:hover {
    color: var(--color-accent-light);
  }

  .issue-author {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
</style>
