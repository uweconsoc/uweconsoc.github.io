---
const issues = [
  { title: "Tariffs and the New Trade Order", date: "Aug 10, 2026", author: "Research Team" },
  { title: "Inside the Bank of Canada's Rate Decision", date: "Aug 3, 2026", author: "Research Team" },
  { title: "Tech Layoffs: A Labor Market Signal?", date: "Jul 27, 2026", author: "Research Team" },
];
---

<div class="newspaper card">
  <div class="section-header">
    <h2>Weekly Newsletter</h2>
    <a href="/newspaper" class="view-all">View All →</a>
  </div>

  <ul class="issue-list">
    {issues.map((issue) => (
      <li class="issue-item">
        <p class="issue-date">{issue.date}</p>
        <h3 class="issue-title">{issue.title}</h3>
        <p class="issue-author">{issue.author}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: 1.75rem;
    color: var(--color-accent-cream);
  }

  .view-all {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .issue-list {
    list-style: none;
  }

  .issue-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .issue-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .issue-title {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .issue-title a {
    color: inherit;
  }

  .issue-title a:hover {
    color: var(--color-accent-light);
  }

  .issue-author {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }

  .card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 10px;
    padding: 1.5rem;
    height: 100%;
    box-sizing: border-box;
  }
</style>