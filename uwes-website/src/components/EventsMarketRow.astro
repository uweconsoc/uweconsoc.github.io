---
import Events from './Events.astro';
import MarketOverview from './MarketOverview.astro';
---

<section class="row-section">
  <div class="row-inner">
    <div class="col-events">
      <Events />
    </div>
    <div class="col-market">
      <MarketOverview />
    </div>
  </div>
</section>

<style>
  .row-section {
    padding: 4rem 2rem;
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(to right, transparent, rgba(240, 220, 174, 0.3), transparent) 1;
  }

  .row-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .row-inner {
      grid-template-columns: 1fr;
    }
  }
</style>