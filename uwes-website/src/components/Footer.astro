---
import { Icon } from 'astro-icon/components';
---

<footer class="footer">
  <div class="footer-inner">
    <div class="stay-connected">
      <h3 class="connect-title">Stay Connected</h3>
      <div class="social-icons">
        <a href="https://www.instagram.com/uweconsoc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <Icon name="simple-icons:instagram" width={18} height={18} />
        </a>
        <a href="https://x.com/UWEconSoc" target="_blank" rel="noopener noreferrer" aria-label="X">
          <Icon name="simple-icons:x" width={18} height={18} />
        </a>
        <a href="https://www.facebook.com/uweconsoc/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <Icon name="simple-icons:facebook" width={18} height={18} />
        </a>
        <a href="mailto:uw.economics.society@gmail.com" target="_blank" rel="noopener noreferrer" aria-label="Email">
          <Icon name="simple-icons:gmail" width={18} height={18} />
        </a>
      </div>
    </div>

    <p class="footer-name">University of Waterloo Economics Society</p>
    <p class="footer-copyright">© 2026 UW Economics Society. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(245, 241, 234, 0.1);
    padding: 3rem 2rem 2rem;
    margin-top: 2rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .stay-connected {
    margin-bottom: 2.5rem;
  }

  .connect-title {
    font-size: 1.1rem;
    color: var(--color-accent-light);
    margin-bottom: 1rem;
  }

  .social-icons {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
  }

  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--color-card-bg);
    color: var(--color-accent-light);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .social-icons a svg {
    width: 20px;
    height: 20px;
  }

  .social-icons a:hover {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .footer-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .footer-copyright {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
