---
import { getCollection } from 'astro:content';
import { formatDate } from '../data/terms.ts';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<div class="articles card">
  <div class="section-header">
    <h2>Research Articles</h2>
    <a href="/articles" class="view-all">View All →</a>
  </div>

  <ul class="article-list">
    {articles.map((article) => (
        <li class="article-item">
         <p class="article-date">{formatDate(article.data.date)}</p>
          <h3 class="article-title"><a href={`/articles/${article.id}`}>{article.data.title}</a></h3>
         <p class="article-author">{article.data.author}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .section-header {
    margin-bottom: 1.5rem;
  }

  .article-list {
    list-style: none;
  }

  .article-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .article-title {
    font-size: 1.15rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .article-title a {
    color: inherit;
    font-size: 1.15rem;
  }

  .article-title a:hover {
    color: var(--color-accent-light);
  }

  .article-author {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
</style>