---
const featuredMembers = [
  { name: "Ishaan Wason", role: "Co-President", photo: "/images/team/avatars/Ishaan_Wason.JPG" },
  { name: "Ernest Bakhchinian", role: "Co-President", photo: "/images/team/avatars/Ernest_Bakhchinian.jpg" },
  { name: "Mateo Racco", role: "VP Finance", photo: "/images/team/avatars/Mateo_Racco.jpeg" },
  { name: "Amogh Mani Murugan", role: "VP Events", photo: "/images/team/avatars/Amogh_Murugan.jpeg" },
  { name: "Tulika Sharma", role: "VP Research", photo: "/images/team/avatars/Tulika_Sharma.jpg" },
  { name: "Isabel Chelaidite", role: "VP Communications", photo: "/images/team/avatars/Isabel_Chelaidite.jpeg" },
];
---

<section class="team-section">
  <div class="team-inner">
    <div class="section-header">
      <h2>Meet the Team</h2>
      <a href="/team" class="view-all">View All →</a>
    </div>

    <div class="team-grid">
      {featuredMembers.map((person) => (
        <div class="team-card">
          <img src={person.photo} alt={person.name} class="team-photo" />
          <h3 class="team-name">{person.name}</h3>
          <p class="team-role">{person.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section {
    padding: 4rem 2rem;
  }

  .team-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: 1.75rem;
    color: var(--color-accent-cream);
  }

  .view-all {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 1.5rem;
    margin: 0 auto;
  }

  .team-card {
    background-color: var(--color-card-bg);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  .team-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 0 auto 1rem;
  }

  .team-name {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .team-role {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }
</style>