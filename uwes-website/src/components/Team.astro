---
import { Image } from 'astro:assets';
import { featuredMembers, resolvePhoto } from '../data/team.js';
---

<section class="team-section">
    <div class="team-inner">
        <div class="section-header">
            <h2>Meet the Team</h2>
            <a href="/team" class="view-all">View All →</a>
        </div>

        <div class="team-grid">
            {
                featuredMembers.map((person) => (
                    <div class="team-card">
                        <Image
                            src={resolvePhoto(person.photo)}
                            alt={person.name}
                            class="team-photo"
                            width={200}
                            format="webp"
                        />
                        <h3 class="team-name">{person.name}</h3>
                        <p class="team-role">{person.role}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .team-section {
        padding: 4rem 2rem;
    }

    .team-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-header {
        margin-bottom: 2rem;
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 1.5rem;
        margin: 0 auto;
    }

    .team-photo {
        width: 100px;
        height: 100px;
    }

    .team-name {
        font-size: 1.15rem;
        margin-bottom: 0.3rem;
    }

    .team-role {
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        .team-grid {
            grid-template-columns: 1fr;
            justify-items: center;
        }
    }
</style>
