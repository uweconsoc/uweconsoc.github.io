---
import { getCollection } from 'astro:content';
import AddToCalendar from './AddToCalendar.astro';
import { formatTimeRange } from '../utils/calendar.js';
import { formatDate } from '../data/terms.ts';
import { splitEvents } from '../utils/events.ts';

const { upcoming } = splitEvents(await getCollection('events'));
const events = upcoming.slice(0, 3);
---

<div class="events card">
  <div class="section-header">
    <h2>Events</h2>
    <a href="/events" class="view-all">View All →</a>
  </div>

  {events.length === 0 ? (
    <p class="empty-state">No upcoming events scheduled — check back soon.</p>
  ) : (
    <ul class="event-list">
      {events.map((event) => (
        <li class="event-item">
          <p class="event-date">{formatDate(event.data.date)} · {formatTimeRange(event.data.startTime, event.data.endTime)}</p>
          <h3 class="event-title">{event.data.title}</h3>
          <p class="event-location">{event.data.location}</p>
          {event.data.description && (
            <p class="event-description">{event.data.description}</p>
          )}
          <AddToCalendar event={event.data} compact />
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .section-header {
    margin-bottom: 1.5rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .event-list {
    list-style: none;
  }

  .event-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .event-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-location {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .event-description {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>
