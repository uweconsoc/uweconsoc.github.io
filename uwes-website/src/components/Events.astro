---
const events = [
  { title: "Networking Night with Alumni, Faculty, Distinguished Guest Speakers from the Finance Industry, and Special Guests from Local Investment Firms and Consulting Companies", date: "Sept 5, 2026", location: "SLC Great Hall" },
  { title: "Intro to Behavioral Economics Talk", date: "Aug 28, 2026", location: "HH 180" },
  { title: "Trading Simulation Workshop", date: "Aug 20, 2026", location: "STC 0060" },
];
---

<div class="events card">
  <div class="section-header">
    <h2>Events</h2>
    <a href="/events" class="view-all">View All →</a>
  </div>

  <ul class="event-list">
    {events.map((event) => (
      <li class="event-item">
        <p class="event-date">{event.date}</p>
               <h3 class="event-title"><a href="#">{event.title}</a></h3>
        <p class="event-location">{event.location}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .section-header {
    margin-bottom: 1.5rem;
  }

  .event-list {
    list-style: none;
  }

  .event-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .event-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-location {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .event-title a {
    color: inherit;
  }

  .event-title a:hover {
    color: var(--color-accent-light);
  }
</style>