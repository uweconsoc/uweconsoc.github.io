---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const teamGroups = [
  {
    name: "Executive",
    members: [
      { name: "Ishaan Wason", role: "Co-President", major: "ARBUS", photo: "/images/team/avatars/Ishaan_Wason.JPG" },
      { name: "Ernest Bakhchinian", role: "Co-President", major: "Economics", photo: "/images/team/avatars/Ernest_Bakhchinian.jpg" },
    ],
  },
  {
    name: "Finance Team",
    members: [
      { name: "Mateo Racco", role: "VP Finance", major: "ARBUS in Economics", photo: "/images/team/avatars/Mateo_Racco.jpeg" },
      { name: "Mark Ghazi", role: "Finance Coordinator", major: "Master of Arts in Economics", photo: "/images/team/avatars/Mark_Ghazi.jpeg" },
      { name: "Andrew Ferrara", role: "Finance Coordinator", major: "Economics and Business", photo: "/images/team/avatars/Andrew_Ferrara.jpeg" },
    ],
  },
  {
    name: "Event Team",
    members: [
      { name: "Amogh Mani Murugan", role: "VP of Events", major: "Economics", photo: "/images/team/avatars/Amogh_Murugan.jpeg" },
      { name: "Maurya Shah", role: "Events Coordinator", major: "Science and Business", photo: "/images/team/avatars/Maurya_Shah.jpg" },
      { name: "Yumna Naleem", role: "Events Coordinator", major: "Economics", photo: "/images/team/avatars/Yumna_Naleem.jpeg" },
      { name: "Charan Kalyana Sundaram", role: "Events Coordinator", major: "Accounting and Financial Management", photo: "/images/team/avatars/Charan_KS.png" },
    ],
  },
  {
    name: "Research Team",
    members: [
      { name: "Tulika Sharma", role: "VP Research", major: "Economics and Business", photo: "/images/team/avatars/Tulika_Sharma.jpg" },
      { name: "Charlotte Grieco", role: "Research Analyst", major: "Math/FARM", photo: "/images/team/avatars/Charlotte_Grieco.jpeg" },
      { name: "Fadekemi Odu-Onikosi", role: "Research Writer", major: "Mathematical Economics", photo: "/images/team/avatars/Fadekemi_Odu-Onikosi.JPG" },
      { name: "Jianing Li", role: "Research Analyst", major: "Master of Arts in Economics", photo: "/images/team/avatars/Jianing_Li.jpeg" },
    ],
  },
  {
    name: "Communications Team",
    members: [
      { name: "Isabel Chelaidite", role: "VP Communications", major: "Economics and Business", photo: "/images/team/avatars/Isabel_Chelaidite.jpeg" },
    ],
  },
  {
    name: "Marketing Team",
    members: [
      { name: "TBD", role: "VP Marketing", major: "" },
    ],
  },
  {
    name: "Web Dev Team",
    members: [
      { name: "Jianing Li", role: "Web Developer", major: "Master of Arts in Economics", photo: "/images/team/avatars/Jianing_Li.jpeg" },
      { name: "Sargun Singh Bhatti", role: "Software Developer", major: "Computer Science", photo: "/images/team/avatars/Sargun_Bhatti.jpg" },
    ],
  },
];
---

<Layout title="Team - UW Economics Society">
  <Nav />
  <main  class="section-light">
    <section class="team-page">
      <div class="team-page-inner">
        <h1 class="page-title">Meet the Team</h1>
        <p class="page-subtitle">The people behind UWES</p>

        {teamGroups.map((group) => (
          <div class="team-group">
            <h2 class="group-title">{group.name}</h2>
            <div class="team-grid">
              {group.members.map((person) => (
                <div class="team-card">
                  {person.photo ? (
                    <img src={person.photo} alt={person.name} class="team-photo" />
                  ) : (
                    <div class="team-photo-placeholder"></div>
                  )}
                  <h3 class="team-name">{person.name}</h3>
                  <p class="team-role">{person.role}</p>
                  {person.major && <p class="team-major">{person.major}</p>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .team-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .team-page-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .page-subtitle {
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .team-group {
    margin-bottom: 3rem;
  }

  .group-title {
    font-size: 1.5rem;
    color: var(--color-accent-light);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-card-border);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.75rem;
  }

  .team-card {
    background-color: var(--color-card-bg);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  .team-photo-placeholder,
  .team-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto 1rem;
  }

  .team-photo-placeholder {
    background-color: rgba(232, 146, 42, 0.15);
  }

  .team-photo {
    object-fit: cover;
    display: block;
  }

  .team-name {
    font-size: 1rem;
    margin-bottom: 0.35rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .team-role {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
    margin-bottom: 0.3rem;
  }

  .team-major {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.4;
    margin-top: 0.15rem;
  }
</style>