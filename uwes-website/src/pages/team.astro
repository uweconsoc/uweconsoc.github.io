---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { teamGroups, resolvePhoto } from '../data/team.js';
---

<Layout title="Team - UW Economics Society">
  <Nav />
  <main  class="section-light">
    <section class="team-page">
      <div class="team-page-inner">
        <h1 class="page-title">Meet the Team</h1>
        <p class="page-subtitle">The people behind UWES</p>

        {teamGroups.map((group) => (
          <div class="team-group">
            <h2 class="group-title">{group.name}</h2>
            <div class="team-grid">
              {group.members.map((person) => (
                <div class="team-card">
                  {person.photo ? (
                    <Image src={resolvePhoto(person.photo)} alt={person.name} class="team-photo" width={240} format="webp" />
                  ) : (
                    <div class="team-photo-placeholder"></div>
                  )}
                  <h3 class="team-name">{person.name}</h3>
                  <p class="team-role">{person.role}</p>
                  {person.major && <p class="team-major">{person.major}</p>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .team-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .team-page-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-subtitle {
    margin-bottom: 3rem;
  }

  .team-group {
    margin-bottom: 3rem;
  }

  .group-title {
    font-size: 1.5rem;
    color: var(--color-accent-light);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-card-border);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.75rem;
  }

  .team-photo-placeholder,
  .team-photo {
    width: 120px;
    height: 120px;
  }

  .team-photo-placeholder {
    border-radius: 50%;
    margin: 0 auto 1rem;
    background-color: rgba(232, 146, 42, 0.15);
  }

  .team-name {
    font-size: 1rem;
    margin-bottom: 0.35rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .team-role {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
    margin-bottom: 0.3rem;
  }

  .team-major {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.4;
    margin-top: 0.15rem;
  }
</style>