---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page Not Found - UW Economics Society">
  <Nav />
  <main class="section-light">
    <section class="error-page">
      <div class="error-page-inner">
        <p class="error-code">404</p>
        <h1 class="page-title">Page Not Found</h1>
        <p class="page-subtitle">The page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="btn-primary">Back to Home</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .error-page {
    padding: 6rem 2rem;
    background-color: var(--color-bg);
  }

  .error-page-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .error-code {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 6rem;
    line-height: 1;
    color: var(--color-accent-cream);
    margin-bottom: 1rem;
  }

  .page-subtitle {
    margin-bottom: 2.5rem;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-accent-cream);
    color: var(--color-bg);
    padding: 0.85rem 1.5rem;
    border-radius: 4px;
    font-weight: 700;
  }
</style>
