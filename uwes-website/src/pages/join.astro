---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Join Us - UW Economics Society">
  <Nav />
  <main class="section-light">
    <section class="join-page">
      <div class="join-page-inner">
        <h1 class="page-title">Join Our Team</h1>
        <p class="page-subtitle">Tell us a bit about yourself and we'll be in touch</p>

        <form id="join-form" class="join-form panel" novalidate>
          <div class="form-field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="form-field">
            <label for="email">UWaterloo Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              pattern=".*@uwaterloo\.ca$"
              title="Please use your @uwaterloo.ca email address"
            />
            <span class="field-hint">Must be your @uwaterloo.ca email address</span>
          </div>

          <div class="form-field">
            <label for="program">Waterloo Program</label>
            <input type="text" id="program" name="program" required placeholder="e.g. Economics" />
          </div>

          <div class="form-field">
            <label for="comments">Comments <span class="field-optional">(optional)</span></label>
            <textarea id="comments" name="comments" rows="4" placeholder="Tell us why you'd like to join, or anything else you'd like us to know"></textarea>
          </div>

          <button type="submit" class="submit-btn">Send</button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .join-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .join-page-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .page-subtitle {
    margin-bottom: 2.5rem;
  }

  .join-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-field label {
    font-weight: 700;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .field-optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .field-hint {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .form-field input,
  .form-field textarea {
    background-color: var(--color-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .submit-btn {
    align-self: flex-start;
    background-color: var(--color-accent);
    color: var(--color-bg);
    border: none;
    padding: 0.75rem 1.75rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-body);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .submit-btn:hover {
    opacity: 0.85;
  }
</style>

<script>
  import { CONTACT_EMAIL } from '../data/site.js';

  const form = document.getElementById('join-form') as HTMLFormElement;

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
    const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
    const program = (form.querySelector('#program') as HTMLInputElement).value.trim();
    const comments = (form.querySelector('#comments') as HTMLTextAreaElement).value.trim();

    const subject = `Join Request from ${name}`;
    const bodyLines = [
      `Name: ${name}`,
      `UWaterloo Email: ${email}`,
      `Program: ${program}`,
    ];
    if (comments) {
      bodyLines.push('', `Comments: ${comments}`);
    }

    const body = bodyLines.join('\n');
    const query = `subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    window.location.href = `mailto:${CONTACT_EMAIL}?${query}`;
  });
</script>
