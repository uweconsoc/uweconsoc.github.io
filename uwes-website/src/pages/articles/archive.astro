---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { groupByTerm, formatDate } from '../../data/terms.ts';

const grouped = groupByTerm(await getCollection('articles'));
const seasonOrder: Record<string, number> = { Fall: 3, Spring: 2, Winter: 1 };
const termOrder: string[] = Object.keys(grouped).sort((a: string, b: string) => {
  const [seasonA, yearA] = a.split(' ');
  const [seasonB, yearB] = b.split(' ');
  if (yearA !== yearB) return Number(yearB) - Number(yearA);
  return seasonOrder[seasonB] - seasonOrder[seasonA];
});
---

<Layout title="Articles Archive - UW Economics Society">
  <Nav />
  <main class="section-light">
    <section class="archive-page">
      <div class="archive-page-inner">
        <div class="page-header">
          <h1 class="page-title">Articles Archive</h1>
          <a href="/articles" class="view-all-header">Back to Articles →</a>
        </div>
        <p class="page-subtitle">Browse past research articles by term</p>

        {termOrder.map((term, index) => (
          <details class="term-group" open={index === 0}>
            <summary class="term-header">
              {term}
              <span class="term-count">({grouped[term].length})</span>
            </summary>
            <ul class="article-list">
              {grouped[term].map((article) => (
                <li class="article-item">
                  <p class="article-date">{formatDate(article.data.date)}</p>
                  <h3 class="article-title"><a href={`/articles/${article.id}`}>{article.data.title}</a></h3>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .archive-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .archive-page-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-subtitle {
    margin-bottom: 2.5rem;
  }

  .term-group {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 10px;
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .term-header {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .term-header::-webkit-details-marker {
    display: none;
  }

  .term-header::before {
    content: '▸';
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  .term-group[open] .term-header::before {
    transform: rotate(90deg);
  }

  .term-count {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 400;
  }

  .article-list {
    list-style: none;
    padding: 0 1.5rem 1rem;
  }

  .article-item {
    padding: 1rem 0;
    border-top: 1px solid var(--color-card-border);
  }

  .article-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .article-title a {
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .article-title a:hover {
    color: var(--color-accent-light);
  }
</style>