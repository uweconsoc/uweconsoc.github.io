---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { formatDate } from '../../data/terms.ts';
import { resolveArticleCover } from '../../data/articleCovers.js';

export async function getStaticPaths() {
  const entries: CollectionEntry<'articles'>[] = await getCollection('articles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'articles'>;
};

const { entry } = Astro.props;
const cover = resolveArticleCover(entry.id);
---

<Layout title={`${entry.data.title} - UW Economics Society`}>
  <Nav />
  <main class="section-light">
    <section class="article-detail-page">
      <div class="article-detail-inner">
        <div class="page-header">
          <a href="/articles" class="view-all-header">← Back to Articles</a>
        </div>
        <article class="card article-detail-card">
          {cover && (
            <Image src={cover} alt={entry.data.coverAlt ?? ''} format="webp" loading="eager" fetchpriority="high" class="article-detail-cover" />
          )}
          <p class="article-date">{formatDate(entry.data.date)}</p>
          <h1 class="page-title">{entry.data.title}</h1>
          <p class="featured-author">{entry.data.author}</p>
          <div class="pdf-viewer-wrap">
            <embed src={`/articles/${entry.id}.pdf`} type="application/pdf" class="pdf-viewer" />
            <p class="pdf-fallback">
              Trouble viewing the PDF above? <a href={`/articles/${entry.id}.pdf`} download>Download it here</a>.
            </p>
          </div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .article-detail-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .article-detail-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .article-detail-card {
    padding: 2.5rem;
  }

  .article-detail-cover {
    width: 100%;
    max-width: 280px;
    display: block;
    margin: 0 auto 1.5rem;
    border-radius: 8px;
  }

  .article-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .featured-author {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0.3rem 0 1.5rem;
  }

  .pdf-viewer-wrap {
    margin-top: 0.5rem;
  }

  .pdf-viewer {
    width: 100%;
    height: 80vh;
    border: 1px solid var(--color-card-border);
    border-radius: 8px;
  }

  .pdf-fallback {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 0.75rem;
    text-align: center;
  }

  .pdf-fallback a {
    color: var(--color-accent-cream);
    text-decoration: underline;
  }
</style>
