---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import EventsMarketRow from '../components/EventsMarketRow.astro';
import NewspaperArticlesRow from '../components/NewspaperArticlesRow.astro';
import Team from '../components/Team.astro';
import Footer from '../components/Footer.astro';
import logoBanner from '../assets/logo-banner.png';
---

<Layout title="UW Economics Society" preloadImage={logoBanner}>
  <Nav />
  <main>
    <Hero />
    <EventsMarketRow />
    <NewspaperArticlesRow />
    <Team />
  </main>
  <Footer />
</Layout>