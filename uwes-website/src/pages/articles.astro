---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { researchArticles } from '../data/articles.js';

const [featuredArticle, ...otherArticles] = researchArticles;
const MAX_VISIBLE = 6;
const visibleArticles = otherArticles.slice(0, MAX_VISIBLE);
const hasMoreArticles = otherArticles.length > MAX_VISIBLE;
---

<Layout title="Research Articles - UW Economics Society">
  <Nav />
  <main class="section-light">
    <section class="articles-page">
      <div class="articles-page-inner">
        <h1 class="page-title">Research Articles</h1>
        <p class="page-subtitle">In-depth analysis from the UWES research team</p>

        <div class="articles-layout">
          <div class="featured-article panel">
            <div class="featured-flyer"></div>
            <p class="article-date">{featuredArticle.date}</p>
            <h2 class="featured-title"><a href="#">{featuredArticle.title}</a></h2>
            <p class="featured-author">{featuredArticle.author}</p>
            <p class="featured-excerpt">{featuredArticle.excerpt}</p>
            <a href="#" class="read-more">Read Full Article →</a>
          </div>

          <div class="side-block panel">
            <div class="side-block-header">
              <h3 class="side-block-title">More Articles</h3>
              <a href="/articles/archive" class="view-all-page">View All →</a>
            </div>

            {otherArticles.length === 0 ? (
              <p class="empty-state">No additional articles yet — check back soon.</p>
            ) : (
              <ul class="article-list">
                {visibleArticles.map((article) => (
                  <li class="article-item">
                    <p class="article-date">{article.date}</p>
                    <h4 class="article-title"><a href="#">{article.title}</a></h4>
                    <p class="article-excerpt">{article.excerpt}</p>
                  </li>
                ))}
              </ul>
            )}

            {hasMoreArticles && (
              <a href="/articles/archive" class="view-all-page view-all-inline">View all articles →</a>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .articles-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .articles-page-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-subtitle {
    margin-bottom: 3rem;
  }

  .articles-layout {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 3rem;
  }

  .featured-flyer {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: rgba(23, 57, 43, 0.15);
    border-radius: 8px;
    margin-bottom: 1.25rem;
  }

  .featured-title a {
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .featured-title a:hover {
    color: var(--color-accent-light);
  }

  .featured-author {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0.3rem 0 0.75rem;
  }

  .featured-excerpt {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .read-more {
    color: var(--color-accent-cream);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .view-all-page {
    color: var(--color-accent-cream);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .view-all-inline {
    display: inline-block;
    margin-top: 1rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: 1rem 0;
  }

  .article-list {
    list-style: none;
  }

  .article-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-card-border);
  }

  .article-item:last-child {
    border-bottom: none;
  }

  .article-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .article-title a {
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .article-title a:hover {
    color: var(--color-accent-light);
  }

  .article-excerpt {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-top: 0.3rem;
  }

  @media (max-width: 900px) {
    .articles-layout {
      grid-template-columns: 1fr;
    }
  }
</style>