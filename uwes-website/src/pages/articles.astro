---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const articles = [
  { title: "Modeling Inflation Expectations in Post-Pandemic Markets", date: "Aug 12, 2026", author: "Research Team" },
  { title: "The Economics of University Housing Shortages", date: "Aug 5, 2026", author: "Research Team" },
  { title: "ESG Investing: Signal or Noise?", date: "Jul 29, 2026", author: "Research Team" },
  { title: "Behavioral Biases in Retail Investing", date: "Jul 22, 2026", author: "Research Team" },
  { title: "Trade Policy and Supply Chain Resilience", date: "Jul 15, 2026", author: "Research Team" },
];
---

<Layout title="Research Articles - UW Economics Society">
  <Nav />
  <main class="section-light">
    <section class="articles-page">
      <div class="articles-page-inner">
        <h1 class="page-title">Research Articles</h1>
        <p class="page-subtitle">In-depth analysis from the UWES research team</p>

        <ul class="article-list">
          {articles.map((article) => (
            <li class="article-item">
              <p class="article-date">{article.date}</p>
               <h3 class="article-title"><a href="#">{article.title}</a></h3>
              <p class="article-author">{article.author}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .articles-page {
    padding: 3rem 2rem;
    background-color: var(--color-bg);
  }

  .articles-page-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .page-subtitle {
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .article-list {
    list-style: none;
  }

  .article-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-card-border);
  }

  .article-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .article-title a {
    color: var(--color-text);
    font-size: 1.15rem;
  }

  .article-title a:hover {
    color: var(--color-accent-light);
  }

  .article-author {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
</style>