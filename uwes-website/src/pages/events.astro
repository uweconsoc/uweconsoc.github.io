---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const upcomingEvents = [
  { title: "Networking Night with Alumni", date: "Sept 5, 2026", location: "SLC Great Hall" },
  { title: "Intro to Behavioral Economics Talk", date: "Aug 28, 2026", location: "HH 180" },
  { title: "Trading Simulation Workshop", date: "Aug 20, 2026", location: "STC 0060" },
];

const pastEvents = [
  { title: "Summer Kickoff Social", date: "May 15, 2026", location: "SLC Multipurpose Room" },
  { title: "Guest Talk: Careers in Central Banking", date: "Apr 3, 2026", location: "HH 227" },
];
---

<Layout title="Events - UW Economics Society">
  <Nav />
  <main>
    <section class="events-page">
      <div class="events-page-inner">
        <h1 class="page-title">Events</h1>
        <p class="page-subtitle">Talks, workshops, and socials hosted by UWES</p>

        <div class="events-group">
          <h2 class="group-title">Upcoming</h2>
          <ul class="event-list">
            {upcomingEvents.map((event) => (
              <li class="event-item">
                <p class="event-date">{event.date}</p>
                <h3 class="event-title"><a href="#">{event.title}</a></h3>
                <p class="event-location">{event.location}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="events-group">
          <h2 class="group-title">Past</h2>
          <ul class="event-list">
            {pastEvents.map((event) => (
              <li class="event-item">
                <p class="event-date">{event.date}</p>
                <h3 class="event-title"><a href="#">{event.title}</a></h3>
                <p class="event-location">{event.location}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .events-page {
    padding: 3rem 2rem;
  }

  .events-page-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .events-group {
    margin-bottom: 3rem;
  }

  .event-title a {
    color: inherit;
  }

  .event-title a:hover {
    color: var(--color-accent-light);
  }

  .group-title {
    font-size: 1.5rem;
    color: var(--color-accent-light);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .event-list {
    list-style: none;
  }

  .event-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .event-date {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .event-location {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>