---
import { getImage } from "astro:assets";
import "../styles/global.css";
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource-variable/playfair-display/wght.css";
import dmSansWoff from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import playfairWoff from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";
import navIcon from "../assets/logo-icon-white-bg.png";

const { title = "UW Economics Society", preloadImage } = Astro.props;

const navIconImage = await getImage({ src: navIcon, width: 56, format: "webp" });
const heroImage = preloadImage ? await getImage({ src: preloadImage, width: 840, format: "webp" }) : null;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/images/logo-icon.png" />
        <title>{title}</title>

        <link
            rel="preload"
            as="image"
            href={navIconImage.src}
            fetchpriority="high"
        />
        {
            heroImage && (
                <link
                    rel="preload"
                    as="image"
                    href={heroImage.src}
                    fetchpriority="high"
                />
            )
        }

        <link rel="preload" as="font" type="font/woff2" href={dmSansWoff} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={playfairWoff} crossorigin />
    </head>
    <body>
        <slot />
    </body>
</html>
